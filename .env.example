# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Freelancer.com ---
# Personal Access Token: https://www.freelancer.com/settings/api (docs: Authentication / Personal Access Tokens)
# Treat as a password. NEVER commit the real value.
FREELANCER_ACCESS_TOKEN=
FREELANCER_BASE_URL=https://www.freelancer.com/api
FREELANCER_TIMEOUT_SECONDS=20

# --- Database (PostgreSQL for prod, sqlite+aiosqlite allowed for local dev/tests) ---
DATABASE_URL=postgresql+asyncpg://freelancer:freelancer@localhost:5432/freelancer_assistant

# --- Admin REST API protection ---
# Long random string, e.g. `openssl rand -hex 32`. Empty disables auth (LOCAL DEV ONLY).
ADMIN_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat ids allowed to command the bot, e.g. 123456789
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Worker cadence (seconds) ---
SEARCH_POLL_INTERVAL_SECONDS=300
BID_POLL_INTERVAL_SECONDS=180
THREAD_POLL_INTERVAL_SECONDS=120
PENDING_ACTION_TTL_SECONDS=900
SEARCH_PAGE_LIMIT=100
